# ==============================================================================
# Global Graffiti Wall - Production Environment Configuration Template
# Copy this file to '.env.production' on your production server:
#   cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & SSL/TLS Configuration (Caddy Automatic Let's Encrypt)
# ------------------------------------------------------------------------------
# Public fully qualified domain name pointing to your server IP (e.g. A/AAAA DNS record)
DOMAIN_NAME=graffiti.yourdomain.com

# Email address for Let's Encrypt renewal & expiration notices
ACME_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# 2. Database & Storage Credentials (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
# Strong system administrator password for Microsoft SQL Server 2022
# Generate with: openssl rand -base64 24
MSSQL_SA_PASSWORD=ReplaceWithStrongProductionPassword123!#

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# 512-bit cryptographically random secret key for HMAC SHA-256 JWT signing
# Generate with: openssl rand -base64 64
JWT_SECRET=ReplaceWithA512BitCryptographicallyRandomKeyForJwtSigning789!#$

JWT_ISSUER=GlobalGraffitiWall
JWT_AUDIENCE=GlobalGraffitiWallClient

# ------------------------------------------------------------------------------
# 4. Networking & CORS Policy
# ------------------------------------------------------------------------------
# Restrict API & SignalR CORS origins strictly to your production domain(s)
# Comma-separated if multiple (e.g. https://graffiti.yourdomain.com,https://www.graffiti.yourdomain.com)
CORS_ALLOWED_ORIGINS=https://graffiti.yourdomain.com

# ------------------------------------------------------------------------------
# 5. Canvas Engine & High-Concurrency Scaling
# ------------------------------------------------------------------------------
# Maximum rapid placement burst capacity per user (default: 16)
CANVAS_MAX_CAPACITY=16

# Rate of charge regeneration in units per second (default: 0.2 = 1 charge every 5s)
CANVAS_REFILL_RATE=0.2

# Enable Redis Backplane for horizontal scale-out across multiple API container replicas
ENABLE_REDIS_BACKPLANE=true

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServerConnection": "Server=localhost;Database=Graffiti;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "CanvasSettings": {
    "MaxCapacity": 16,
    "RefillRatePerSecond": 0.2,
    "EnableLiveCursors": true,
    "CursorThrottleMs": 100,
    "MaxCursorsPerViewport": 25
  },
  "JwtSettings": {
    "Secret": "GlobalGraffitiWall_SuperSecretKey_ForSigningTokens_2026!#*CustomJwtKey789",
    "Issuer": "GlobalGraffitiWall",
    "Audience": "GlobalGraffitiWallClient",
    "ExpirationDays": 30
  }
}